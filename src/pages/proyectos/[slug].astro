---
import { ArrowLeft, ArrowUpRight, CheckCircle2, Code2, Database, GitBranch, Layers3 } from 'lucide-react';
import TechPill from '../../components/TechPill';
import { projects, technologies, type Project } from '../../data/portfolio';
import '../../styles/global.css';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props as { project: Project };
const techByName = new Map(technologies.map((tech) => [tech.name, tech]));
const canonical = new URL(`/proyectos/${project.slug}/`, Astro.site).href;
const description = `${project.title}: ${project.description}`;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#080b10" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="article" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:title" content={`${project.title} | Caso de estudio`} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/tech-icons.css" />
    <title>{project.title} | Caso de estudio de Leonardo Condori</title>
  </head>
  <body>
    <main class="case-study-page">
      <div class="section-shell">
        <a class="case-back-link" href="/#projects">
          <ArrowLeft size={18} aria-hidden="true" />
          Volver a proyectos
        </a>

        <header class="case-hero">
          <p class="section-kicker">Caso de estudio · {project.category}</p>
          <h1>{project.title}</h1>
          <p>{project.description}</p>
          <div class="case-meta">
            <span><GitBranch size={17} aria-hidden="true" />{project.caseStudy.role}</span>
            {project.status ? <span>{project.status}</span> : null}
          </div>
          <div class="technology-tags">
            {project.technologies.map((label) => {
              const tech = techByName.get(label);
              return <TechPill compact label={label} iconId={tech?.id} hex={tech?.hex} />;
            })}
          </div>
          <div class="case-actions">
            {project.repoUrl ? (
              <a class="primary-button" href={project.repoUrl} target="_blank" rel="noreferrer">
                <Code2 size={18} aria-hidden="true" />
                Ver código
              </a>
            ) : null}
            {project.demoUrl ? (
              <a class="secondary-button" href={project.demoUrl} target="_blank" rel="noreferrer">
                <ArrowUpRight size={18} aria-hidden="true" />
                Abrir demo
              </a>
            ) : null}
          </div>
        </header>

        <section class="case-section case-problem">
          <p class="section-kicker">Contexto</p>
          <h2>El problema</h2>
          <p>{project.problem}</p>
        </section>

        <section class="case-grid">
          <article class="case-card glass-card">
            <span class="case-card-icon"><Layers3 size={21} aria-hidden="true" /></span>
            <p class="section-kicker">Implementación</p>
            <h2>Arquitectura y decisiones</h2>
            <ul>
              {project.caseStudy.architecture.map((item) => <li>{item}</li>)}
            </ul>
          </article>

          <article class="case-card glass-card">
            <span class="case-card-icon"><CheckCircle2 size={21} aria-hidden="true" /></span>
            <p class="section-kicker">Calidad</p>
            <h2>Evidencia técnica</h2>
            <ul>
              {project.caseStudy.quality.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        </section>

        {project.caseStudy.dataFlow ? (
          <section class="case-section case-data-flow">
            <span class="case-card-icon"><Database size={21} aria-hidden="true" /></span>
            <p class="section-kicker">Datos</p>
            <h2>Flujo reproducible</h2>
            <ol>
              {project.caseStudy.dataFlow.map((step) => <li>{step}</li>)}
            </ol>
          </section>
        ) : null}

        {project.contribution ? (
          <section class="case-section">
            <p class="section-kicker">Aporte</p>
            <h2>Qué construí</h2>
            <p>{project.contribution}</p>
          </section>
        ) : null}

        {project.result ? (
          <section class="case-section case-result">
            <p class="section-kicker">Resultado</p>
            <h2>Qué cambió</h2>
            <p>{project.result}</p>
          </section>
        ) : null}
      </div>
    </main>
  </body>
</html>
